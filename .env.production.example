# Copy to .env.production and replace every placeholder before deployment.
# The production commands upload these values as encrypted Worker secrets.

APP_NAME=Family Fax
APP_VERSION=0.1.0
AUTH_MODE=access
FAX_PROVIDER=signalwire
APP_BASE_URL=https://fax.example.com
CF_ACCESS_AUD=replace-with-access-audience
CF_ACCESS_TEAM_DOMAIN=replace-with-team.cloudflareaccess.com

WEBHOOK_BASE_URL=https://fax-events.example.com
WEBHOOK_USERNAME=replace-with-random-username
WEBHOOK_PASSWORD=replace-with-long-random-password

SIGNALWIRE_PROJECT_ID=replace-with-project-id
SIGNALWIRE_API_TOKEN=replace-with-api-token
SIGNALWIRE_SPACE_URL=your-space.signalwire.com
SIGNALWIRE_LOCAL_NUMBER_MONTHLY_PRICE=0.50
SIGNALWIRE_ACCOUNT_MODE=trial
# Confirm the current provider rule for your account. This overrides the
# account-mode default of 30 trial days or 14 funded days.
SIGNALWIRE_MINIMUM_NUMBER_HOLD_DAYS=30

EMAIL_FROM_ADDRESS=fax@example.com
DEFAULT_FORWARD_EMAIL=family@example.com
DEFAULT_PHONE_COUNTRY=US
PREFERRED_AREA_CODES=615,629

DEFAULT_TTL_DAYS=3
TTL_PRESETS=1,3,7,14
MAX_TTL_DAYS=365
DEFAULT_RENTAL_MONTHS=1
RENTAL_MONTH_PRESETS=1,2,3
MAX_RENTAL_MONTHS=12

DEFAULT_RETENTION=forever
LOG_DETAIL=full
MAX_UPLOAD_BYTES=26214400
MAX_FAX_PAGES=100
# Keep this below the verified-destination message-size limit after allowing
# for MIME encoding overhead.
MAX_EMAIL_ATTACHMENT_BYTES=18000000

# Sinch is an optional provider. When FAX_PROVIDER=sinch, remove the SignalWire
# values above and configure all five values below.
# SINCH_PROJECT_ID=replace-with-project-id
# SINCH_SERVICE_ID=replace-with-fax-service-id
# SINCH_REGION=global
# SINCH_KEY_ID=replace-with-key-id
# SINCH_KEY_SECRET=replace-with-key-secret
