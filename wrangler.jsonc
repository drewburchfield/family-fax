{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "family-fax",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*", "/provider-content/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-fax",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "family-fax-documents"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "workflows": [
    {
      "name": "family-fax-outbound",
      "binding": "OUTBOUND_FAX_WORKFLOW",
      "class_name": "OutboundFaxWorkflow"
    },
    {
      "name": "family-fax-number-lifecycle",
      "binding": "NUMBER_LIFECYCLE_WORKFLOW",
      "class_name": "NumberLifecycleWorkflow"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "APP_NAME": "Family Fax",
    "APP_VERSION": "0.1.0",
    "AUTH_MODE": "dev",
    "FAX_PROVIDER": "demo",
    "DEFAULT_PHONE_COUNTRY": "US",
    "DEFAULT_FORWARD_EMAIL": "fax@example.com",
    "PREFERRED_AREA_CODES": "615,629",
    "DEFAULT_TTL_DAYS": "3",
    "TTL_PRESETS": "1,3,7,14",
    "MAX_TTL_DAYS": "365",
    "DEFAULT_RENTAL_MONTHS": "1",
    "RENTAL_MONTH_PRESETS": "1,2,3",
    "MAX_RENTAL_MONTHS": "12",
    "DEFAULT_RETENTION": "forever",
    "LOG_DETAIL": "full",
    "MAX_UPLOAD_BYTES": "26214400",
    "MAX_FAX_PAGES": "100",
    "MAX_EMAIL_ATTACHMENT_BYTES": "18000000"
  }
}
